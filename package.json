{
  "name": "dsh-pr-chip",
  "version": "0.1.3",
  "type": "module",
  "description": "Pull request state chip on every DSH session row.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "pull-request",
    "code-review"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "lib/",
    "locale/*.json",
    "icon.png",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
